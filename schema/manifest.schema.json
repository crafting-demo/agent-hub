{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crafting-demo/agent-hub/schema/manifest.schema.json",
  "title": "Agent Hub manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "category",
    "description",
    "sources",
    "persona",
    "runtime"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,18}[a-z0-9]$",
      "maxLength": 20,
      "description": "Must be a valid Crafting LLMAgent name."
    },
    "name": { "type": "string", "minLength": 1 },
    "category": {
      "type": "string",
      "enum": ["product", "engineering", "security", "operations", "legal", "design", "docs"]
    },
    "description": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "persona": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instructions"],
      "properties": {
        "instructions": { "type": "string", "pattern": "^\\./.+\\.md$" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent"],
      "properties": {
        "agent": { "type": "string", "pattern": "^\\./.+\\.ya?ml$" }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": { "type": "string" },
          "requires": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/capability" }
    },
    "collaboration": { "$ref": "#/$defs/collaboration" },
    "use_cases": {
      "type": "array",
      "items": { "$ref": "#/$defs/use_case" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "kind", "used_for"],
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "kind": {
          "type": "string",
          "enum": ["official-vendor", "popular-oss", "standard"]
        },
        "stars": { "type": "integer", "minimum": 0 },
        "used_for": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["persona", "skills", "tools", "process"]
          }
        }
      },
      "if": {
        "properties": { "kind": { "const": "popular-oss" } },
        "required": ["kind"]
      },
      "then": {
        "required": ["stars"],
        "properties": {
          "stars": { "type": "integer", "minimum": 10000 }
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "providers"],
      "properties": {
        "label": { "type": "string" },
        "description": { "type": "string" },
        "required": { "type": "boolean", "default": false },
        "kind_hint": { "type": "string", "enum": ["mcp", "cli"] },
        "operations": {
          "type": "array",
          "items": { "type": "string" }
        },
        "providers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/provider" }
        },
        "verification": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "connection_authenticated",
              "selected_context_accessible",
              "required_capabilities_available",
              "cli_executable"
            ]
          }
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "kind": { "type": "string", "enum": ["mcp", "cli"] },
        "connection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ref": { "type": "string", "minLength": 1 }
          }
        },
        "tool_mapping": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "configuration": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/config_field" }
        },
        "tool": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "mcp" } }, "required": ["kind"] },
          "then": { "required": ["connection"] }
        },
        {
          "if": { "properties": { "kind": { "const": "cli" } }, "required": ["kind"] },
          "then": { "required": ["tool"] }
        }
      ]
    },
    "config_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "type"],
      "properties": {
        "label": { "type": "string" },
        "type": { "type": "string", "enum": ["string", "text", "boolean"] },
        "required": { "type": "boolean" },
        "description": { "type": "string" }
      }
    },
    "collaboration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_pattern": {
          "type": "string",
          "enum": ["single_agent", "coordinator"]
        },
        "optional": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "pattern"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "pattern": {
                "type": "string",
                "enum": ["delegate_to_agent", "fan_out"]
              },
              "agent_dependency": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "role": { "type": "string" },
                  "selection": {
                    "type": "string",
                    "enum": ["existing_agent", "hub_entry"]
                  }
                }
              },
              "requires": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "use_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "prompt"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "requires": {
          "type": "array",
          "items": { "type": "string" }
        },
        "requires_patterns": {
          "type": "array",
          "items": { "type": "string" }
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "type"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "type": { "type": "string", "enum": ["string", "text", "boolean"] },
              "required": { "type": "boolean" }
            }
          }
        },
        "prompt": { "type": "string" }
      }
    }
  }
}
